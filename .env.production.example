DATABASE_URL=postgres://linkit:${POSTGRES_PASSWORD}@postgres:5432/linkit
RABBITMQ_URL=amqp://linkit:${RABBITMQ_PASSWORD}@rabbitmq:5672
APP_URL=https://linkit.example.com
AUTH_SECRET=replace-with-at-least-32-random-characters
REVALIDATE_SECRET=replace-with-at-least-32-random-characters
AUTH_TRUST_HOST=true
CADDY_SITE_ADDRESS=linkit.example.com

# Optional OAuth.
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# Optional metadata/image integrations.
LINK_METADATA_PROVIDER=embedly
EMBEDLY_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional notifications. Configure all three values together.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAIL_FROM=Linkit <notifications@linkit.example.com>

# Backing service credentials.
POSTGRES_PASSWORD=replace-with-postgres-password
RABBITMQ_PASSWORD=replace-with-rabbitmq-password
