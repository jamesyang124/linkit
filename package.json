{
  "name": "linkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build",
    "dev:prod-stack": "docker compose up --build",
    "dev:web": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "worker": "tsx src/worker/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "env:check": "tsx scripts/check-env.ts",
    "cache:revalidate": "tsx scripts/revalidate-cache.ts",
    "images:process-existing": "tsx scripts/process-existing-thumbnails.ts",
    "seed:dev": "tsx scripts/seed-dev.ts",
    "seed:designspiration": "tsx scripts/seed-designspiration-pins.ts",
    "seed:gallery": "tsx scripts/seed-gallery.ts",
    "seed:reseed": "tsx scripts/reseed.ts",
    "legacy:import": "tsx scripts/legacy/import-migration.ts",
    "legacy:verify": "tsx scripts/legacy/verify-migration.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "latest",
    "amqplib": "latest",
    "bcryptjs": "latest",
    "drizzle-orm": "latest",
    "ioredis": "^5.10.1",
    "masonic": "^4.1.0",
    "next": "latest",
    "next-auth": "^5.0.0-beta.31",
    "postgres": "latest",
    "react": "latest",
    "react-dom": "latest",
    "sharp": "^0.35.0",
    "zod": "latest"
  },
  "overrides": {
    "postcss": "^8.5.15"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/amqplib": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "latest",
    "drizzle-kit": "^0.31.10",
    "jsdom": "latest",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.17",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
